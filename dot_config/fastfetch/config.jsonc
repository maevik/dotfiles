{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "left": 2
        },
        // "type": "small",
        "color": {
            "1": "37",
            "2": "37",
            "3": "37",
            "4": "37",
            "5": "37",
            "6": "37",
            "7": "37",
            "8": "37",
            "9": "37"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "title": "37",
            "keys": "37",
            "output": "37"
        },
        "key": {
            "width": 15
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "───────────────────────────────────"
        },
        {
            "type": "os",
            "key": "󰣇  OS",
            "keyColor": "37"
        },
        {
            "type": "kernel",
            "key": "󰒋  Kernel"
        },
        {
            "type": "packages",
            "key": "󰏖  Packages"
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime"
        },
        {
            "type": "wm",
            "key": "󱂬  WM"
        },
        {
            "type": "shell",
            "key": "󱆃  Shell"
        },
        {
            "type": "terminal",
            "key": "󰆍  Term"
        },
        {
            "type": "cpu",
            "key": "󰻠  CPU",
            "showPeCoreCount": false,
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "󰍛  Memory",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "󰋊  Storage",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "display",
            "key": "󰍹  Monitor",
            "compactType": "none"
        },
        {
            "type": "custom",
            "format": "───────────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "🮀"
        }
    ]
}
