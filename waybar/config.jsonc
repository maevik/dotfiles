{
  "position": "bottom",
  "spacing": 0,
  "height": 30,
  "layer": "top",
  "reload_style_on_change": true,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],

  // "modules-center": [
    // "hyprland/window"
  // ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    // "network",
    "pulseaudio",
    // "battery",
    "clock"
  ],

  "hyprland/workspaces": {
    "format": "{name}"
  },

  "hyprland/window": {
    "max-length": 50,
    "separate-outputs": true
  },

  "hyprland/submap": {
    "format": "Mode: {}"
  },

  "tray": {
    "spacing": 10,
    "tooltip": false
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 2,
    "states": { "critical": 90 }
  },

  "memory": {
    "format": "  {percentage}%",
    "interval": 2,
    "states": { "critical": 80 }
  },

  "network": {
    "format-wifi": "  {bandwidthDownBits}",
    "format-ethernet": "󰈀  {bandwidthDownBits}",
    "format-disconnected": "󰤮  No Net",
    "interval": 5,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip": false
  },

  "clock": {
    "format": "  {:%I:%M %p}",
    "tooltip": false
  }
}
